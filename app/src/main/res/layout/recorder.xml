<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="@dimen/content_width" android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Body" android:text="@string/app_name" android:fontFamily="sans-serif-medium" android:letterSpacing="0.06"/>
        <TextView style="@style/Heading" android:text="@string/title" android:textSize="36sp" android:layout_marginBottom="24dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="24dp" android:gravity="center_horizontal" android:background="@drawable/card">
            <TextView android:id="@+id/status" style="@style/Body" android:gravity="center" android:accessibilityLiveRegion="polite" android:text="@string/ready"/>
            <Chronometer android:id="@+id/timer" style="@style/Heading" android:accessibilityHeading="false" android:gravity="center" android:textSize="52sp" android:fontFeatureSettings="tnum" android:layout_marginBottom="16dp"/>
            <Button android:id="@+id/toggle" style="@style/Action" android:layout_width="wrap_content" android:minWidth="160dp"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:drawablePadding="10dp" android:drawableStart="@drawable/ic_record"
                android:textColor="@color/on_accent" android:background="@drawable/action" android:text="@string/record"/>
        </LinearLayout>
        <TextView style="@style/Body" android:layout_marginTop="12dp" android:text="@string/footer"/>
        <TextView android:id="@+id/notice" style="@style/Body" android:layout_marginTop="12dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        <Button android:id="@+id/permission_settings" style="@style/Action" android:text="@string/settings" android:visibility="gone"/>
        <TextView style="@style/Heading" android:layout_marginTop="28dp" android:labelFor="@id/profile" android:text="@string/profile"/>
        <Button android:id="@+id/profile" style="@style/Action" android:text="@string/auto"/>
        <TextView android:id="@+id/detail" style="@style/Body"/>
        <LinearLayout android:id="@+id/last_clip" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:visibility="gone">
            <TextView style="@style/Heading" android:text="@string/latest"/>
            <TextView android:id="@+id/clip_name" style="@style/Body"/>
            <TextView style="@style/Body" android:text="@string/storage"/>
            <Button android:id="@+id/play" style="@style/Action" android:text="@string/play"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
