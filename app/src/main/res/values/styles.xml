<resources>
    <style name="BaseTheme" parent="android:style/Theme.Material.Light.NoActionBar"/>
    <style name="AppTheme" parent="BaseTheme">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <bool name="light_bars">true</bool>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/secondary</item>
    </style>
    <style name="Heading" parent="Body">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Action">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
    <dimen name="content_width">-1px</dimen>
</resources>
